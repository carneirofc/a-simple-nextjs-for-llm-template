# Copy to .env.local. All values optional in development.

# --- Database ---------------------------------------------------------------
# Unset in development => embedded PGlite at ./.data/pglite (auto-migrated).
# Required in production (Postgres connection string).
# DATABASE_URL=postgres://user:password@localhost:5432/app

# --- Feature toggles (true|false) -------------------------------------------
FEATURE_AUTH=false
FEATURE_NOTES_EXAMPLE=true
# Server-Sent Events at /api/v1/events; the UI invalidates queries when events arrive.
FEATURE_REALTIME=true

# --- Background event processing (transactional outbox) ---------------------
# inline   = each server instance polls the outbox (default; needs a long-running server).
# external = a scheduler (cron, k8s CronJob) calls POST /api/internal/jobs with
#            "Authorization: Bearer $JOBS_SECRET" (serverless).
JOBS_RUNNER=inline
JOBS_POLL_INTERVAL_MS=1000
# JOBS_SECRET=generate-with-openssl-rand-base64-32

# --- Auth (Better Auth) — required only when FEATURE_AUTH=true ---------------
# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# BETTER_AUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
